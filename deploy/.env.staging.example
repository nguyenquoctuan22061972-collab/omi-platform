# Staging env for omi-platform-staging (NAMES only — fill values from your secret store; never commit real values).
# Used by: docker compose -f deploy/docker-compose.staging.yml --env-file deploy/.env.staging up -d --build

# --- auth-rbac + affos-runtime JWT ---
AUTH_SECRET=                 # openssl rand -hex 32 ; shared by auth-rbac and affos-runtime (JWT verify)
AFFOS_JWT_ISS=               # optional in staging; set to enforce issuer (recommended before prod)
AFFOS_JWT_AUD=               # optional in staging; set to enforce audience

# --- staging Postgres (AFFOS DATABASE_URL is derived from these in the compose) ---
AFFOS_PG_DB=affos_staging
AFFOS_PG_USER=affos
AFFOS_PG_PASSWORD=           # secret store

# --- WF060 (n8n) only; set when enabling the dry-run workflow in staging ---
AFFOS_SVC_PASSWORD=          # n8n variable for the svc-revenue login (NOT read by affos-runtime)

# Derived in docker-compose.staging.yml (do not set here):
#   DATABASE_URL=postgresql://${AFFOS_PG_USER}:${AFFOS_PG_PASSWORD}@postgres:5432/${AFFOS_PG_DB}
#   AFFOS_INGEST_DB=/data/affos_ingest.db   AFFOS_RUNTIME_PORT=8099   AFFOS_ENVIRONMENT=staging
