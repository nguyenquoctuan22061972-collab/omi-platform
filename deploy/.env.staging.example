# Staging env for omi-platform-staging (NAMES only — fill values from your secret store; never commit real values).
# Used by: docker compose -f deploy/docker-compose.staging.yml --env-file deploy/.env.staging up -d --build

# --- JWT (auth-rbac stamps iss/aud; affos-runtime enforces them — staging REQUIRES both) ---
AUTH_SECRET=                        # openssl rand -hex 32 ; shared by auth-rbac + affos-runtime
AFFOS_JWT_ISS=affos-auth-staging    # non-secret; auth-rbac issues it, affos-runtime enforces it
AFFOS_JWT_AUD=affos-revenue         # non-secret; must match on both services

# --- Dedicated staging Postgres (Option A) — SEPARATE accounts per responsibility ---
AFFOS_PG_DB=affos_staging
AFFOS_PG_SUPERUSER=affos_bootstrap       # bootstrap superuser (runs roles.sql ONCE); not used at runtime
AFFOS_PG_SUPERUSER_PASSWORD=             # secret
AFFOS_PG_OWNER_PASSWORD=                 # secret — affos_owner (runs migrations 0001–0005; DDL)
AFFOS_PG_SERVICE_PASSWORD=               # secret — affos_service (runtime; least-privilege DML)

# --- WF060 (n8n) only; set when enabling the dry-run workflow in staging ---
AFFOS_SVC_PASSWORD=                       # n8n variable for svc-revenue login (NOT read by affos-runtime)

# Derived in docker-compose.staging.yml (do not set here):
#   DATABASE_URL=postgresql://affos_service:${AFFOS_PG_SERVICE_PASSWORD}@postgres:5432/${AFFOS_PG_DB}
#   AUTH_JWT_ISS/AUD = AFFOS_JWT_ISS/AUD ; AFFOS_RUNTIME_PORT=8099 ; AFFOS_ENVIRONMENT=staging
# Runtime durable store = Postgres (0004/0005 tables) via DATABASE_URL — NOT SQLite.
