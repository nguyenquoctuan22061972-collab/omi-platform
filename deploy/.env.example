# OMI Platform — Production (.env.example). Copy -> deploy/.env và điền. KHÔNG commit .env.

# Domain & SSL (Let's Encrypt)
OMI_DOMAIN=omi.example.com
LETSENCRYPT_EMAIL=admin@example.com

# Auth (BẮT BUỘC — sinh chuỗi mạnh, vd: openssl rand -hex 32)
AUTH_SECRET=

# Ports nội bộ (thường giữ mặc định)
CRM_PORT=8080
AUTH_PORT=8081

# Dashboard: đặt config.js với CRM_BASE=/api/crm (same-origin qua nginx)

# Backup
BACKUP_DIR=./backups
BACKUP_KEEP=14

# Alerting (tuỳ chọn)
ALERT_WEBHOOK_URL=
