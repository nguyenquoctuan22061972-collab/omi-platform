{
  "name": "WF004 — AI Call Intelligence",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "wf004-call-intelligence",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "functionCode": "// Validation: bắt buộc audio_url + contact. Không log secret.\nconst b = ($json.body) || $json;\nif (!b || !b.audio_url) { throw new Error('WF004: thiếu audio_url'); }\nif (!b.contact || !(b.contact.phone || b.contact.email)) { throw new Error('WF004: thiếu contact.phone/email'); }\nreturn [{ json: { audio_url: b.audio_url, contact: b.contact, lang: b.lang || 'vi-VN', received_at: new Date().toISOString() } }];"
      },
      "name": "Validation",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [420, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.VERTEX_STT_URL}}",
        "authentication": "predefinedCredentialType",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ audio_url: $json.audio_url, languageCode: $json.lang }) }}",
        "options": {}
      },
      "name": "Vertex STT",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [640, 300],
      "credentials": { "googleApi": { "id": "", "name": "Vertex STT (đặt trong n8n)" } },
      "disabled": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.VERTEX_SUMMARY_URL}}",
        "authentication": "predefinedCredentialType",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ transcript: $json.transcript, task: 'call_summary' }) }}",
        "options": {}
      },
      "name": "AI Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [860, 300],
      "credentials": { "googleApi": { "id": "", "name": "Vertex Summary (đặt trong n8n)" } },
      "disabled": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.CRM_BASE}}/conversations",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contact: $json.contact, channel: 'call', summary: $json.summary, transcript: $json.transcript }) }}",
        "options": {}
      },
      "name": "CRM Update",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1080, 300]
    },
    {
      "parameters": {
        "chatId": "={{$env.TELEGRAM_CHAT_ID}}",
        "text": "={{ 'Call summary cho ' + ($json.contact.phone || $json.contact.email) + ':\\n' + $json.summary }}",
        "additionalFields": {}
      },
      "name": "Telegram Notify",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [1300, 300],
      "credentials": { "telegramApi": { "id": "", "name": "Telegram (đặt trong n8n)" } },
      "disabled": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.CRM_BASE}}/audit",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ event: 'workflow_activation', actor: 'WF004', target: 'call_intelligence', meta: { contact: $json.contact } }) }}",
        "options": {}
      },
      "name": "Audit",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1520, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.CRM_BASE}}/metrics/ingest",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ metric: 'workflow_count', workflow: 'WF004', value: 1 }) }}",
        "options": {}
      },
      "name": "Metrics",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1740, 300]
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Validation", "type": "main", "index": 0 }]] },
    "Validation": { "main": [[{ "node": "Vertex STT", "type": "main", "index": 0 }]] },
    "Vertex STT": { "main": [[{ "node": "AI Summary", "type": "main", "index": 0 }]] },
    "AI Summary": { "main": [[{ "node": "CRM Update", "type": "main", "index": 0 }]] },
    "CRM Update": { "main": [[{ "node": "Telegram Notify", "type": "main", "index": 0 }]] },
    "Telegram Notify": { "main": [[{ "node": "Audit", "type": "main", "index": 0 }]] },
    "Audit": { "main": [[{ "node": "Metrics", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "tags": ["WF004", "call-intelligence", "additive"]
}
