# OMI Platform — Automation n8n (.env.example)
# Copy thành .env và điền giá trị thật. KHÔNG commit .env.

# --- n8n ---
N8N_BASE_URL=http://localhost:5678

# --- CRM Core API (PRD-001) ---
CRM_BASE=http://localhost:8080

# --- WF002 notify (Slack) — bật node "Notify Sales (Slack)" sau khi điền ---
SALES_SLACK_CHANNEL=

# --- WF050 report (Email/SMTP) — bật node "Send Report (Email)" sau khi điền ---
REPORT_FROM_EMAIL=
REPORT_TO_EMAIL=

# --- Channel credentials: cấu hình trong n8n Credentials UI, KHÔNG để ở đây ---
# Facebook Messenger  : n8n credential "Facebook Graph API"
# Zalo OA             : HTTP Header Auth credential
# Telegram            : n8n credential "Telegram API"
# Email (inbound)     : IMAP credential
# SMTP (outbound)     : SMTP credential
